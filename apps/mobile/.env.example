# Base URL of the deployed SLLights web app (the mobile app calls its
# /api/mobile/* routes; it never talks to APIM directly). No trailing slash.
# For a phone on the same Wi-Fi as `npm run web`, use your machine's LAN IP,
# e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=https://your-sllights-web-host.example.com

# Dev only: uncomment to keep the welcome screen up (no 5 s auto-advance)
# while reviewing its design. Ignored in release builds.
# EXPO_PUBLIC_HOLD_WELCOME=1

# Development/store builds only (not Expo Go): Google Maps SDK for Android
# key for the pole page's Location map. Restrict it to the app's package
# name and signing certificate. iOS uses Apple Maps and needs none.
# GOOGLE_MAPS_ANDROID_API_KEY=

# Development/store builds only: the web app's domain, so emailed invite and
# password-reset links open this app. Also set APPLE_TEAM_ID and
# ANDROID_SHA256_CERT_FINGERPRINTS on the web app (Vercel) so it publishes
# the matching verification files. Leave unset to keep links on the web.
# APP_LINK_DOMAIN=dashboard.example.com
