# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set the same names under Project Settings -> Environment Variables.

# --- Azure APIM (required) ---------------------------------------------------
# Ocp-Apim-Subscription-Key. Server-side only; never prefix with NEXT_PUBLIC_.
APIM_SUBSCRIPTION_KEY=
# Optional; defaults to https://lights-v2-apim.azure-api.net
NEXT_PUBLIC_APIM_BASE_URL=
# Optional; seconds to cache APIM reads (default 30)
APIM_CACHE_SECONDS=

# --- Google Maps (pole/project maps) -----------------------------------------
# Browser-exposed by design; restrict the key by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Leadsun lamp status (remote control) ------------------------------------
# Combined client certificate + private key PEM for Leadsun's mutual-TLS API.
LEADSUN_CLIENT_CERT_PEM=
# Optional; overrides the built-in default base URL
LEADSUN_LAMP_STATUS_BASE_URL=
# Leave unset. "true" disables TLS verification (MITM risk).
LEADSUN_ALLOW_SELF_SIGNED_CERT=
